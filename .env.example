# Server
PORT=5000
# IMPORTANT: keep this as "development" for local work. Auth cookies are
# marked `secure` (HTTPS-only) whenever NODE_ENV=production, so if you flip
# this to production on a local http:// server, login will silently appear
# to succeed but no cookies will actually be stored by the browser.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Paystack (Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Rate limiting (general API; auth routes have their own stricter limiter)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging (optional) - one of: error, warn, info, http, debug
LOG_LEVEL=debug

# Brevo transactional email — start disabled in staging.
# Configure a VERIFIED Brevo sender + domain with SPF/DKIM/DMARC.
# Use the Brevo v3 API key (server-only); do not use SMTP credentials here.
BREVO_ENABLED=false
BREVO_WORKER_ENABLED=false
# Default only explicitly listed test inboxes can receive emails.
# Set BREVO_SEND_SCOPE=all only after a reviewed production release.
BREVO_SEND_SCOPE=allowlist
BREVO_ALLOWED_RECIPIENTS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Delixious
# 32 random bytes, BASE64 encoded: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=
# Configure Brevo transactional webhook auth as Authorization: Bearer token.
# Generate a secret with: openssl rand -hex 32
BREVO_WEBHOOK_TOKEN=
# Public applications must not trigger arbitrary emails without CAPTCHA.
BREVO_APPLICANT_ACK_ENABLED=false

# Staging rider proof (server-only, at least 32 random characters)
DELIVERY_HANDOFF_SECRET=
