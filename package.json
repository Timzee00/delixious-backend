{
  "name": "delixious-backend",
  "version": "1.0.0",
  "description": "Delixious full-stack food-ordering platform (React/Vite frontend + Express API)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "postinstall": "node scripts/prepare-frontend.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:frontend",
    "build:frontend": "npm ci --include=dev --prefix frontend && npm run build --prefix frontend",
    "test:frontend": "npm test --prefix frontend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
